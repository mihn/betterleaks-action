{
  "name": "betterleaks-action",
  "version": "1.0.0",
  "description": "GitHub Action for Betterleaks secrets detection",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "package": "ncc build lib/main.js -o dist --source-map --license licenses.txt",
    "test": "vitest run --coverage",
    "all": "npm run build && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dortort/betterleaks-action.git"
  },
  "keywords": [
    "github-actions",
    "security",
    "secrets-detection",
    "betterleaks"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
